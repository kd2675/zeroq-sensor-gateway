# Copy to .env. Java properties syntax: unquoted values, no export.
# The local API listens on 127.0.0.1:20191. Generate separate random keys.
GATEWAY_NODE_ID=GW-STORE-001
GATEWAY_LOCAL_API_KEY=
GATEWAY_CLOUD_BASE_URL=http://localhost:8080
# Must match cloud-back-server.
ZEROQ_GATEWAY_SHARED_SECRET=
GATEWAY_SYNC_ENABLED=true
# Authenticated BLE needs real per-sensor keys. Do not enable legacy frames for convenience.
ZEROQ_BLE_ALLOW_LEGACY_UNSIGNED=false
